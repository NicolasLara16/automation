          "allowUnauthorizedCerts": false
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "name": "HTTP Request",
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analise o {{ $json.texto_pagina }}. Identifique se existe alguma oportunidade de Pós-Graduação (Especialização, Mestrado ou Doutorado) que atenda rigorosamente a TODOS os critérios a seguir:\n\nÁrea: Tecnologia da Informação, Ciência da Computação, Engenharia de Software, Sistemas de Informação ou áreas correlatas.\n\nModalidade: EAD / A Distância.\n\nCusto: Gratuita (sem mensalidades).\n\nResponda no formato JSON:\n{ \"eh_valido\": true/false, \"nome_curso\": \"\", \"instituicao\": \"\", \"link\": \"\", \"prazo_inscricao\": \"\" } \n\nResponda APENAS e ESTRITAMENTE com um objeto JSON válido, sem qualquer texto adicional antes ou depois. Não utilize blocos de código Markdown (como json ou ).",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        896,
        0
      ],
      "name": "AI Agent"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatDeepSeek",
      "typeVersion": 1,
      "position": [
        880,
        192
      ],
      "name": "DeepSeek Chat Model"
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "texto_pagina",
              "cssSelector": "body"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "name": "HTML"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
